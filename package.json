{
  "name": "agentic-form",
  "version": "0.1.2",
  "description": "Validate form leads and write local NDJSON or POST to webhooks and Agentic CRM with a Node.js library, CLI, and MCP server.",
  "keywords": [
    "webhook",
    "agentic-crm",
    "form",
    "form-validation",
    "lead",
    "lead-capture",
    "email-validation",
    "ndjson",
    "nodejs",
    "typescript",
    "cli",
    "mcp"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "https://github.com/pooriaarab/agentic-form.git"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agentic-form": "./dist/cli.js",
    "agentic-form-mcp": "./dist/mcp-bin.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "agentic-core": "^0.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
